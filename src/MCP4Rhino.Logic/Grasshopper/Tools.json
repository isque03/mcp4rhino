          "type": "string"
        }
      },
      "required": [
        "session_id",
        "expected_revision",
        "request_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
