  {
    "name": "gh_get_solution_summary",
    "description": "Read a bounded snapshot of graph controls, persistent inputs, selected named outputs and diagnostics for one current result. Numerical outputs have no inferred physical dimensions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
