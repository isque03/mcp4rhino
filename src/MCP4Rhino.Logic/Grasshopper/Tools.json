[
  {
    "name": "gh_help",
    "description": "Grasshopper parametric-design help for this package. Topics: index, quickstart, design, data-trees, workflow, debugging, examples/array, examples/facade, examples/loft. Works without Grasshopper. Also: resources, inspection, capture, examples/profile, examples/stair.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "gh_status",
    "description": "Check Grasshopper availability, runtime state and v1 limits without loading the editor.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "gh_search_components",
    "description": "Search installed component metadata: verified, available or restricted, with assembly authorization status. Search does not instantiate components. Discovery initializes Grasshopper.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "gh_describe_components",
    "description": "Inspect component types, port IDs, defaults and access modes. Available types require local assembly trust before instantiation; denied types return metadata only. Discovery initializes Grasshopper.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "component_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 50
        }
      },
      "required": [
        "component_ids"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
