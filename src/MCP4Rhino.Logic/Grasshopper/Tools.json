  {
    "name": "gh_capture_canvas",
    "description": "Render the requested native Grasshopper canvas to PNG without showing or switching the editor. Framing: current (default, requires this document active), fit, or rectangle. View state is preserved. Returns bounded MCP image content.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "result_id": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "path": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        },
        "framing": {
          "enum": [
            "current",
            "fit",
            "rectangle"
          ]
        },
        "rectangle": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "session_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
