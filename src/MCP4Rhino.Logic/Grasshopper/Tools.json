  {
    "name": "gh_apply_patch",
    "description": "Apply a validated batch under one undo record. Slider-only patches preserve unrelated plugin objects; other edits require authorized graph objects. Uses temporary aliases. solve defaults false. See gh_help(workflow).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "request_id": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "add"
                  },
                  "alias": {
                    "type": "string"
                  },
                  "component_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "op",
                  "alias",
                  "component_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "remove"
                  },
                  "node": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "node"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "connect"
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "node": {
                        "type": "string"
                      },
                      "port": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "node",
                      "port"
                    ],
                    "additionalProperties": false
                  },
                  "target": {
                    "type": "object",
                    "properties": {
                      "node": {
                        "type": "string"
                      },
                      "port": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "node",
                      "port"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "op",
                  "source",
                  "target"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "disconnect"
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "node": {
                        "type": "string"
                      },
                      "port": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "node",
                      "port"
                    ],
                    "additionalProperties": false
                  },
                  "target": {
                    "type": "object",
                    "properties": {
                      "node": {
                        "type": "string"
                      },
                      "port": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "node",
                      "port"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "op",
                  "source",
                  "target"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set_value"
                  },
                  "node": {
                    "type": "string"
                  },
                  "port": {
                    "type": "string"
                  },
                  "tree": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 1
                        },
                        "items": {
                          "type": "array",
                          "items": {}
                        }
                      },
                      "required": [
                        "path",
                        "items"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 2000
                  }
                },
                "required": [
                  "op",
                  "node",
                  "port",
                  "tree"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set_slider"
                  },
                  "node": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  },
                  "integer": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "op",
                  "node",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set_properties"
                  },
                  "node": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "preview": {
                    "type": "boolean"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "op",
                  "node"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set_mapping"
                  },
                  "node": {
                    "type": "string"
                  },
                  "port": {
                    "type": "string"
                  },
                  "mapping": {
                    "enum": [
                      "none",
                      "flatten",
                      "graft"
                    ]
                  },
                  "simplify": {
                    "type": "boolean"
                  },
                  "reverse": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "op",
                  "node",
                  "port"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "layout"
                  }
                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        },
        "solve": {
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "expected_revision",
        "request_id",
        "operations"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "gh_solve",
    "description": "Queue an incremental solve and immediately return a job ID. Heavy solves may block Rhino UI.",
    "inputSchema": {
      "type": "object",
