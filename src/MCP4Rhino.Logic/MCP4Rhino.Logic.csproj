<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MCP4Rhino.Logic</RootNamespace>
    <AssemblyName>MCP4Rhino.Logic</AssemblyName>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Grasshopper/Tools.json" LogicalName="GrasshopperTools.json" />
    <EmbeddedResource Include="Grasshopper/NativeComponents.json" LogicalName="GrasshopperNativeComponents.json" />
    <EmbeddedResource Include="Resources/writing-style.md" LogicalName="ServerGuide.writing-style.md" />
    <EmbeddedResource Include="Resources/getting-started.md" LogicalName="ServerGuide.getting-started.md" />
    <EmbeddedResource Include="Resources/grasshopper-getting-started.md" LogicalName="ServerGuide.grasshopper-getting-started.md" />
    <EmbeddedResource Include="../../skills/grasshopper-parametric-design/**/*.md">
      <LogicalName>GrasshopperHelp/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../skills/grasshopper-parametric-design/assets/*.json">
      <LogicalName>GrasshopperExample/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <ProjectReference Include="..\MCP4Rhino.Contracts\MCP4Rhino.Contracts.csproj" />
  </ItemGroup>
</Project>
