<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MCP4Rhino</RootNamespace>
    <AssemblyName>MCP4Rhino</AssemblyName>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Version>0.4.0</Version>
    <Authors>MCP4Rhino contributors</Authors>
    <Description>Rhino plugin embedding a lightweight MCP server so AI agents can drive Rhino.</Description>
    <Copyright>Copyright (c) 2026</Copyright>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <ProjectReference Include="..\MCP4Rhino.Contracts\MCP4Rhino.Contracts.csproj" />
    <ProjectReference Include="..\MCP4Rhino.Logic\MCP4Rhino.Logic.csproj" />
  </ItemGroup>

</Project>
