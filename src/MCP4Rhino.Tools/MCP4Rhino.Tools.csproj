<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MCP4Rhino.Tools</RootNamespace>
    <AssemblyName>MCP4Rhino.Tools</AssemblyName>
    <Version>0.4.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <ProjectReference Include="..\MCP4Rhino.Contracts\MCP4Rhino.Contracts.csproj" />
    <ProjectReference Include="..\MCP4Rhino.Logic\MCP4Rhino.Logic.csproj" />
    <ProjectReference Include="..\MCP4Rhino\MCP4Rhino.csproj">
      <!-- Tools call UiThread/PluginLog in the host; host must not reference Tools. -->
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>

